# Private monetization files
auditkit-pro/
build-release.sh

# CMMC Level 2 files (private/paid tier only)
**/cmmc_level2*.go
**/cmmc_level2_*.go

# Binaries. Anchored: an unanchored "auditkit" also matched the source
# directory scanner/cmd/auditkit/, so every new file in it was silently
# ignored - two test files sat untracked for that reason.
/scanner/auditkit
/scanner/auditkit-aws
/scanner/auditkit-azure
/scanner/auditkit-gcp
*.exe
*.dll
*.so
*.dylib

# Test data
*.pdf
*.html
# The rule above is for generated scan reports. Pages under site/ are source,
# and without this every new one is silently skipped by git add.
!site/**/*.html
evidence-tracker.html
site/**/evidence-tracker.html
auditkit-fixes.sh
auditkit-report-*

# Go
vendor/
*.test
*.out
go.sum

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local data
.auditkit/

# Env
.env
.env.local
release-notes-*.md
RELEASE-*.md

# Local-only QA tooling: kept out of the public Community repo. These are
# development aids for adding features and counting controls, not product code.
.github/scripts/
.github/coverage-claims.json

# Compiled Python bytecode.
__pycache__/
*.pyc
